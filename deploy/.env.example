# Copy to .env and fill in. Keep .env off git — it holds real credentials.

# The CouchDB the tablets sync with. Scribe reads the library and writes only recognized text.
SCRIBE_COUCH_URL=https://couch.example.com
SCRIBE_COUCH_USER=sync
SCRIBE_COUCH_PASSWORD=
SCRIBE_NOTES_DB=notes
SCRIBE_TEXT_DB=notes_text

# The model. Any OpenAI-compatible server will do; this is Ollama's endpoint inside the compose
# network. The name must be one your server actually has — `docker compose exec model ollama pull
# qwen2.5vl:3b` first.
SCRIBE_MODEL_URL=http://model:11434/v1
SCRIBE_MODEL=qwen2.5vl:3b
# A page on a 6W CPU takes a while. A timeout that fires mid-read costs the whole page.
SCRIBE_MODEL_TIMEOUT=5m
# Recorded on the documents; not used to steer the model.
SCRIBE_LANGUAGE=en

# Identifies this server in the documents it writes. Must differ from the tablets' "boox" and
# "ipad" — that field is how a reader tells who wrote what.
SCRIBE_DEVICE_ID=server

# How long to wait when the change feed is quiet.
SCRIBE_POLL=30s
SCRIBE_LOG_LEVEL=info
