# Copy to .env and fill in. Keep .env off git — it holds real credentials.

# The CouchDB the tablets sync with. Scribe reads the library and writes only recognized text.
SCRIBE_COUCH_URL=https://couch.example.com
SCRIBE_COUCH_USER=sync
SCRIBE_COUCH_PASSWORD=
SCRIBE_NOTES_DB=notes
SCRIBE_TEXT_DB=notes_text

# The model. Any OpenAI-compatible server will do; this is the litellm sidecar inside the compose
# network. The name must be one the server actually serves — for litellm that means a model_name
# from litellm.yaml, not the upstream model id.
SCRIBE_MODEL_URL=http://model:4000/v1
SCRIBE_MODEL=haiku

# Optional. Re-reads only the pages SCRIBE_MODEL appears to have fumbled — non-Latin script, a
# decoder repeating itself, or its own [?] markers. Leave blank to use one model for everything.
SCRIBE_MODEL_STRONG=sonnet

# Read by the litellm sidecar, never by scribe. Needed only when litellm talks to a hosted model.
ANTHROPIC_API_KEY=
# A page on a 6W CPU takes a while. A timeout that fires mid-read costs the whole page.
SCRIBE_MODEL_TIMEOUT=5m
# Recorded on the documents; not used to steer the model. "mul" is the ISO 639-2 code for
# multiple languages, which is the honest answer for a library that mixes them.
SCRIBE_LANGUAGE=mul

# Identifies this server in the documents it writes. Must differ from the tablets' "boox" and
# "ipad" — that field is how a reader tells who wrote what.
SCRIBE_DEVICE_ID=server

# How long to wait when the change feed is quiet.
SCRIBE_POLL=30s
SCRIBE_LOG_LEVEL=info
